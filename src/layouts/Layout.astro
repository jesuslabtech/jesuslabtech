---
import "../styles/global.css";
import "@fontsource/outfit/latin-400.css";
import "@fontsource/outfit/latin-500.css";
import "@fontsource/outfit/latin-600.css";
import "@fontsource/outfit/latin-700.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import { ClientRouter } from "astro:transitions";
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const defaultTitle = "Portfolio de Jesús Merlo - DevOps & Cloud Engineer";
const defaultDescription =
	"Jesús Merlo, Cloud Engineer: infraestructura en AWS, CI/CD, observabilidad y automatización con Terraform.";
const { title = defaultTitle, description = defaultDescription, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, "https://jesuslabtech.vercel.app");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="Astro, DevOps, Cloud Engineer, Portfolio, Jesús Merlo, Desarrollo web, Infraestructura como código, CI/CD, AWS, Docker, Terraform"
		/>
		<meta name="author" content="Jesús Merlo" />
		<meta name="generator" content={Astro.generator} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://jesuslabtech.vercel.app/portfolio-mock.png" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="Portfolio de Jesús Merlo" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://jesuslabtech.vercel.app/portfolio-mock.png" />
		

		<meta name="theme-color" content="#0f172a" />


		<ClientRouter />
		<Analytics />
	</head>
	<body class="dark min-h-screen bg-background text-foreground antialiased">
		<div class="container">
			<slot />
		</div>
		<SpeedInsights />
	</body>
</html>

<style>
	.container {
		max-width: 100%;
		margin: 0 auto;
	}
</style>
