---
import type { Content } from "@/i18n";
import LangSwitch from "./LangSwitch.astro";
const { c, otherHref } = Astro.props as { c: Content; otherHref: string };
---

<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-amber-400 focus:px-4 focus:py-2 focus:text-black">{c.ui.skip}</a>
<header class="f-header sticky top-0 z-50">
	<div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-3">
		<a href="#top" class="text-lg font-semibold text-slate-50">Jesús Merlo</a>
		<nav aria-label="Main" class="order-3 flex w-full flex-wrap gap-x-5 gap-y-1 text-sm text-slate-300 md:order-none md:w-auto">
			{c.nav.map((item) => <a href={item.href} class="hover:text-amber-400">{item.label}</a>)}
		</nav>
		<div class="flex items-center gap-4">
			<span class="hidden items-center gap-2 text-xs text-slate-300 lg:flex f-mono"><span class="f-dot" aria-hidden="true"></span>{c.availability}</span>
			<LangSwitch c={c} href={otherHref} />
		</div>
	</div>
</header>
