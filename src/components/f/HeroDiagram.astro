---
import type { Content } from "@/i18n";
const { c } = Astro.props as { c: Content };
const d = Object.fromEntries(c.diagram.nodes.map((n) => [n.id, n]));
// Posiciones en el lienzo del SVG (viewBox 760 x 280).
const pos: Record<string, [number, number]> = {
	actions: [200, 30],
	argocd: [380, 30],
	k8s: [560, 30],
	terraform: [20, 190],
	aws: [200, 190],
	prometheus: [380, 190],
	grafana: [560, 190],
};
const W = 150;
const H = 56;
const arrows: [string, string][] = [
	["actions", "argocd"],
	["argocd", "k8s"],
	["terraform", "aws"],
	["aws", "prometheus"],
	["prometheus", "grafana"],
];
const center = (id: string) => [pos[id][0] + W / 2, pos[id][1] + H / 2];
---

<section id="top" class="mx-auto max-w-5xl px-6 pb-12 pt-16 md:pt-24">
	<div class="f-hero">
		<p class="f-label mb-6">{c.hero.eyebrow}</p>
		<h1 class="f-hero-title mx-auto max-w-4xl" style="margin-inline: var(--sk-intro-margin, 0);">{c.hero.title}</h1>
		<p class="f-text mt-6 max-w-2xl text-xl" style="margin-inline: var(--sk-intro-margin, 0);">{c.hero.lead}</p>
		<div class="f-actions mt-8">
			<a href="#contact" class="f-btn f-btn-primary">{c.hero.ctaPrimary}</a>
			<a href="#services" class="f-btn">{c.hero.ctaSecondary}</a>
		</div>
	</div>

	<figure class="f-card mt-14" id="diagram">
		<svg viewBox="0 0 760 280" role="group" aria-label={c.diagram.nodes.map((n) => n.label).join(", ")} class="h-auto w-full">
			<defs>
				<marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
					<path d="M0 0L10 5L0 10z" fill="#94a3b8"></path>
				</marker>
			</defs>
			{arrows.map(([a, b]) => {
				const [ax] = center(a);
				const [bx] = center(b);
				const y = center(a)[1];
				return <line x1={ax + W / 2} y1={y} x2={bx - W / 2 - 2} y2={y} stroke="#94a3b8" stroke-width="1.5" marker-end="url(#arr)" />;
			})}
			<line x1={center("actions")[0]} y1={pos.actions[1] + H} x2={center("aws")[0]} y2={pos.aws[1] - 2} stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5 5" marker-end="url(#arr)" />
			<line x1={center("k8s")[0]} y1={pos.k8s[1] + H} x2={center("prometheus")[0] + 60} y2={pos.prometheus[1] - 2} stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="5 5" marker-end="url(#arr)" />
			{c.diagram.nodes.map((n) => (
				<g class="f-node" tabindex="0" role="button" data-node={n.id} data-desc={n.desc} aria-label={`${n.label}: ${n.desc}`} transform={`translate(${pos[n.id][0]} ${pos[n.id][1]})`}>
					<rect width={W} height={H} rx="4"></rect>
					<text x={W / 2} y={H / 2 + 5} text-anchor="middle">{n.label}</text>
				</g>
			))}
		</svg>
		<figcaption id="diagram-desc" class="f-text f-mono mt-4 min-h-[3.5rem] text-sm" aria-live="polite" data-hint={c.diagram.hint}>{c.diagram.hint}</figcaption>
	</figure>
</section>

<script>
	const caption = document.getElementById("diagram-desc");
	const nodes = document.querySelectorAll<SVGGElement>(".f-node");
	const show = (n: SVGGElement) => {
		nodes.forEach((x) => x.removeAttribute("data-on"));
		n.setAttribute("data-on", "");
		if (caption) caption.textContent = n.dataset.desc ?? "";
	};
	nodes.forEach((n) => {
		["mouseenter", "focus", "click"].forEach((ev) => n.addEventListener(ev, () => show(n)));
		n.addEventListener("keydown", (e) => {
			if (e.key === "Enter" || e.key === " ") {
				e.preventDefault();
				show(n);
			}
		});
	});
</script>
