---
import { profile, nav, about, experiences, projects, getLatestPosts, formatDate } from "@/data/site";
const posts = await getLatestPosts();
const mono = "font-family: 'JetBrains Mono', monospace;";
// Un panel plano: borde fino, esquinas rectas, barra de título en mono.
const panel = "border border-slate-700 bg-[#0b1220]";
const bar = "flex items-center justify-between border-b border-slate-700 px-4 py-2 text-xs text-slate-400";
---

<header class="sticky top-0 z-50 border-b border-slate-700 bg-[#030712]/95 backdrop-blur-sm" style={mono}>
	<div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-2.5 text-xs">
		<a href="#top" class="flex items-center gap-2 text-slate-50"><span class="inline-block h-2 w-2 bg-amber-400"></span>jesuslab / portfolio</a>
		<nav aria-label="Principal" class="flex flex-wrap gap-x-5 text-slate-300">
			{nav.map((item) => <a href={item.href} class="hover:text-amber-400">{item.label}</a>)}
		</nav>
	</div>
</header>

<main id="top" class="mx-auto max-w-7xl space-y-4 px-4 py-6">
	<div class="grid gap-4 lg:grid-cols-3">
		<section class={`${panel} lg:col-span-2`}>
			<div class={bar} style={mono}><span>overview</span><span class="text-amber-400">● online</span></div>
			<div class="p-6 md:p-10">
				<p class="text-sm text-amber-400" style={mono}>{profile.role}</p>
				<h1 class="mt-3 text-5xl font-bold tracking-tight text-slate-50 md:text-7xl">{profile.name}</h1>
				<p class="mt-6 max-w-xl text-xl leading-relaxed text-slate-300">{profile.tagline}</p>
				<p class="mt-8 flex flex-wrap gap-3 text-sm" style={mono}>
					<a href="#contact" class="bg-amber-400 px-4 py-2.5 font-medium text-[#1c1203] hover:bg-amber-300">Get in touch</a>
					<a href="#work" class="border border-slate-600 px-4 py-2.5 text-slate-200 hover:border-amber-400 hover:text-amber-400">View work</a>
				</p>
			</div>
		</section>
		<section class={panel}>
			<div class={bar} style={mono}><span>status</span><span>live</span></div>
			<dl class="divide-y divide-slate-800 text-sm" style={mono}>
				<div class="flex justify-between gap-4 px-4 py-3"><dt class="text-slate-400">availability</dt><dd class="text-amber-400">open to work</dd></div>
				<div class="flex justify-between gap-4 px-4 py-3"><dt class="text-slate-400">on-call</dt><dd class="text-slate-200">24/7 AWS</dd></div>
				<div class="flex justify-between gap-4 px-4 py-3"><dt class="text-slate-400">role</dt><dd class="text-slate-200">{experiences[0].title}</dd></div>
				<div class="flex justify-between gap-4 px-4 py-3"><dt class="text-slate-400">since</dt><dd class="text-slate-200">Nov 2024</dd></div>
				<div class="flex justify-between gap-4 px-4 py-3"><dt class="text-slate-400">projects</dt><dd class="text-slate-200">{projects.length}</dd></div>
			</dl>
		</section>
	</div>

	<section id="about" class={`${panel} scroll-mt-16`}>
		<div class={bar} style={mono}><span>about</span><span>stack: {about.stack.length}</span></div>
		<div class="grid gap-8 p-6 md:grid-cols-2 md:p-8">
			<p class="text-lg leading-relaxed text-slate-200">{about.summary}</p>
			<div class="grid gap-6 sm:grid-cols-2" style={mono}>
				<div>
					<h2 class="text-xs text-slate-400">STACK</h2>
					<ul class="mt-3 space-y-1.5 text-sm text-slate-200">{about.stack.map((s) => <li><span class="text-amber-400">▸ </span>{s}</li>)}</ul>
				</div>
				<div>
					<h2 class="text-xs text-slate-400">FOCUS</h2>
					<ul class="mt-3 space-y-1.5 text-sm text-slate-200">{about.focus.map((f) => <li><span class="text-amber-400">▸ </span>{f}</li>)}</ul>
				</div>
			</div>
		</div>
	</section>

	<section id="experience" class={`${panel} scroll-mt-16`}>
		<div class={bar} style={mono}><span>experience</span><span>{experiences.length} {experiences.length === 1 ? "entry" : "entries"}</span></div>
		{experiences.map((exp) => (
			<article class="grid gap-6 p-6 md:grid-cols-3 md:p-8">
				<div>
					<h3 class="text-xl font-semibold text-slate-50">{exp.title}</h3>
					<p class="mt-1 text-sm text-amber-400" style={mono}>{exp.company}</p>
					<p class="mt-1 text-xs text-slate-400" style={mono}>{exp.period} · {exp.location}</p>
				</div>
				<div class="md:col-span-2">
					<p class="text-slate-300 leading-relaxed">{exp.description}</p>
					<table class="mt-5 w-full border-collapse text-sm" style={mono}>
						<tbody>
							{exp.achievements.map((a, i) => (
								<tr class="border-t border-slate-800">
									<th scope="row" class="w-10 py-2 pr-3 text-left font-normal text-slate-400">{String(i + 1).padStart(2, "0")}</th>
									<td class="py-2 text-slate-200">{a}</td>
								</tr>
							))}
						</tbody>
					</table>
					<p class="mt-4 text-xs text-slate-400" style={mono}>{exp.technologies.join(" · ")}</p>
				</div>
			</article>
		))}
	</section>

	<div id="work" class="scroll-mt-16 grid gap-4 md:grid-cols-2">
		{projects.map((p, i) => (
			<section class={panel}>
				<div class={bar} style={mono}><span>work/{String(i + 1).padStart(2, "0")}</span><span>{p.tags[0]}</span></div>
				{p.imgUrl && <img src={p.imgUrl} width={p.imgWidth} height={p.imgHeight} alt={p.title} loading="lazy" class="aspect-[16/9] w-full border-b border-slate-700 object-cover" />}
				<div class="p-5">
					<h3 class="text-xl font-semibold text-slate-50">{p.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-slate-300">{p.description}</p>
					<p class="mt-4 text-xs text-slate-400" style={mono}>{p.tags.join(" · ")}</p>
					<p class="mt-4 flex gap-4 text-xs" style={mono}>
						<a href={p.links.github} target="_blank" rel="noopener noreferrer" class="text-amber-400 underline underline-offset-4 hover:text-amber-300">source ↗</a>
						{p.links.demo && <a href={p.links.demo} target="_blank" rel="noopener noreferrer" class="text-amber-400 underline underline-offset-4 hover:text-amber-300">demo ↗</a>}
					</p>
				</div>
			</section>
		))}
	</div>

	<div class="grid gap-4 md:grid-cols-2">
		<section id="posts" class={`${panel} scroll-mt-16`}>
			<div class={bar} style={mono}><span>posts</span><span>latest {posts.length}</span></div>
			<ul class="divide-y divide-slate-800">
				{posts.map((post) => (
					<li>
						<a href={`/posts/${post.slug}`} class="block px-4 py-4 hover:bg-slate-800/40">
							<time class="text-xs text-slate-400" style={mono}>{formatDate(post.data.date)}</time>
							<span class="mt-1 block font-semibold text-slate-50">{post.data.title}</span>
							<span class="mt-1 block text-sm text-slate-300">{post.data.description}</span>
						</a>
					</li>
				))}
			</ul>
		</section>
		<section id="contact" class={`${panel} scroll-mt-16`}>
			<div class={bar} style={mono}><span>contact</span><span class="text-amber-400">● available</span></div>
			<div class="p-6">
				<p class="text-3xl font-bold tracking-tight text-slate-50">Let's work together</p>
				<p class="mt-3 text-slate-300">I'm currently available for freelance work and full-time opportunities.</p>
				<ul class="mt-6 space-y-2 text-sm" style={mono}>
					<li><span class="text-slate-400">mail </span><a href={`mailto:${profile.email}`} class="text-amber-400 underline underline-offset-4 hover:text-amber-300">{profile.email}</a></li>
					<li><span class="text-slate-400">in   </span><a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="text-slate-200 underline underline-offset-4 hover:text-amber-400">linkedin.com/in/jesusmerlo</a></li>
					<li><span class="text-slate-400">git  </span><a href={profile.github} target="_blank" rel="noopener noreferrer" class="text-slate-200 underline underline-offset-4 hover:text-amber-400">github.com/jesuslabtech</a></li>
				</ul>
			</div>
		</section>
	</div>
</main>

<footer class="mx-auto max-w-7xl px-4 pb-24 pt-2 text-xs text-slate-400" style={mono}>© {new Date().getFullYear()} {profile.name}</footer>

<style>
	html {
		scroll-behavior: smooth;
	}
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>
