---
import { THEMES } from "@/data/themes";
const { current } = Astro.props as { current: string };
---

<nav
	aria-label="Cambiar diseño"
	style="position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:100;display:flex;gap:4px;padding:6px;border-radius:10px;background:#030712;border:1px solid #334155;font-family:'JetBrains Mono',monospace;font-size:12px;"
>
	{THEMES.map((t) => (
		<a
			href={`/preview/${t}`}
			data-astro-reload
			aria-current={t === current ? "page" : undefined}
			style={`padding:8px 12px;border-radius:6px;text-decoration:none;color:${t === current ? "#1c1203" : "#cbd5e1"};background:${t === current ? "#f59e0b" : "transparent"};`}
		>
			{t}
		</a>
	))}
</nav>
