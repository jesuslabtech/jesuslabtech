---
import { profile, nav, about, experiences, projects, getLatestPosts, formatDate } from "@/data/site";
const posts = await getLatestPosts();
const mono = "font-family: 'JetBrains Mono', monospace;";
---

<header class="sticky top-0 z-50 border-b border-slate-800 bg-[#030712]/90 backdrop-blur-sm" style={mono}>
	<div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-6 py-3 text-sm">
		<a href="#top" class="text-amber-400">jesus@lab:~$</a>
		<nav aria-label="Principal" class="flex flex-wrap gap-x-5 text-slate-300">
			{nav.map((item) => (
				<a href={item.href} class="hover:text-amber-400">{item.label}</a>
			))}
		</nav>
	</div>
</header>

<main id="top" class="mx-auto max-w-3xl px-6">
	<section class="pt-20 pb-16 md:pt-28">
		<p class="text-sm text-slate-400" style={mono}><span class="text-amber-400">$</span> whoami</p>
		<h1 class="mt-4 text-5xl font-bold tracking-tight text-slate-50 md:text-7xl">{profile.name}</h1>
		<p class="mt-2 text-lg text-amber-400" style={mono}>{profile.role}<span class="t-cursor" aria-hidden="true">_</span></p>
		<p class="mt-8 max-w-xl text-xl leading-relaxed text-slate-300">{profile.tagline}</p>
		<p class="mt-6 text-sm text-slate-400" style={mono}># {profile.quote}</p>
		<p class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm" style={mono}>
			<a href="#contact" class="text-amber-400 underline underline-offset-4 hover:text-amber-300">./contact</a>
			<a href="#work" class="text-slate-300 underline underline-offset-4 hover:text-amber-400">./work</a>
			<a href={profile.github} class="text-slate-300 underline underline-offset-4 hover:text-amber-400">github</a>
			<a href={profile.linkedin} class="text-slate-300 underline underline-offset-4 hover:text-amber-400">linkedin</a>
		</p>
	</section>

	<section id="about" class="scroll-mt-16 border-t border-slate-800 py-14">
		<h2 class="text-sm text-slate-400" style={mono}><span class="text-amber-400">$</span> cat about.md</h2>
		<p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-200">{about.summary}</p>
		<dl class="mt-8 grid gap-4 text-sm sm:grid-cols-[8rem_1fr]" style={mono}>
			<dt class="text-slate-400">stack</dt>
			<dd class="text-slate-200">{about.stack.join(" · ")}</dd>
			<dt class="text-slate-400">focus</dt>
			<dd class="text-slate-200">
				<ul>
					{about.focus.map((f) => <li><span class="text-amber-400">- </span>{f}</li>)}
				</ul>
			</dd>
		</dl>
	</section>

	<section id="experience" class="scroll-mt-16 border-t border-slate-800 py-14">
		<h2 class="text-sm text-slate-400" style={mono}><span class="text-amber-400">$</span> git log --career</h2>
		<div class="mt-8 space-y-10">
			{experiences.map((exp) => (
				<article class="grid gap-2 md:grid-cols-[11rem_1fr] md:gap-8">
					<p class="text-sm text-slate-400" style={mono}>{exp.period}</p>
					<div>
						<h3 class="text-xl font-semibold text-slate-50">{exp.title}</h3>
						<p class="text-sm text-amber-400" style={mono}>{exp.company} · {exp.location}</p>
						<p class="mt-4 text-slate-300 leading-relaxed">{exp.description}</p>
						<ul class="mt-4 space-y-1 text-sm text-slate-300" style={mono}>
							{exp.achievements.map((a) => <li><span class="text-amber-400">+ </span>{a}</li>)}
						</ul>
						<p class="mt-4 text-xs text-slate-400" style={mono}>{exp.technologies.join(" · ")}</p>
					</div>
				</article>
			))}
		</div>
	</section>

	<section id="work" class="scroll-mt-16 border-t border-slate-800 py-14">
		<h2 class="text-sm text-slate-400" style={mono}><span class="text-amber-400">$</span> ls work/</h2>
		<ol class="mt-8 divide-y divide-slate-800 border-y border-slate-800">
			{projects.map((p, i) => (
				<li class="grid gap-3 py-6 md:grid-cols-[3rem_1fr_auto] md:gap-6">
					<span class="text-sm text-slate-400" style={mono}>{String(i + 1).padStart(2, "0")}</span>
					<div>
						<h3 class="text-xl font-semibold text-slate-50">{p.title}</h3>
						<p class="mt-2 text-slate-300 leading-relaxed">{p.description}</p>
						<p class="mt-3 text-xs text-slate-400" style={mono}>{p.tags.join(" · ")}</p>
					</div>
					<p class="flex gap-4 text-sm md:flex-col md:items-end md:gap-1" style={mono}>
						<a href={p.links.github} target="_blank" rel="noopener noreferrer" class="text-amber-400 underline underline-offset-4 hover:text-amber-300">[code]</a>
						{p.links.demo && <a href={p.links.demo} target="_blank" rel="noopener noreferrer" class="text-amber-400 underline underline-offset-4 hover:text-amber-300">[demo]</a>}
					</p>
				</li>
			))}
		</ol>
	</section>

	<section id="posts" class="scroll-mt-16 py-14">
		<h2 class="text-sm text-slate-400" style={mono}><span class="text-amber-400">$</span> ls -t posts/</h2>
		<ul class="mt-8 space-y-6">
			{posts.map((post) => (
				<li class="grid gap-1 md:grid-cols-[11rem_1fr] md:gap-8">
					<time class="text-sm text-slate-400" style={mono}>{formatDate(post.data.date)}</time>
					<div>
						<a href={`/posts/${post.slug}`} class="text-lg font-semibold text-slate-50 underline-offset-4 hover:text-amber-400 hover:underline">{post.data.title}</a>
						<p class="mt-1 text-slate-300">{post.data.description}</p>
					</div>
				</li>
			))}
		</ul>
	</section>

	<section id="contact" class="scroll-mt-16 border-t border-slate-800 py-14">
		<h2 class="text-sm text-slate-400" style={mono}><span class="text-amber-400">$</span> mail jesus</h2>
		<p class="mt-6 text-3xl font-bold text-slate-50 md:text-4xl">Let's work together.</p>
		<p class="mt-3 max-w-xl text-slate-300">I'm currently available for freelance work and full-time opportunities.</p>
		<p class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm" style={mono}>
			<a href={`mailto:${profile.email}`} class="text-amber-400 underline underline-offset-4 hover:text-amber-300">{profile.email}</a>
			<a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="text-slate-300 underline underline-offset-4 hover:text-amber-400">linkedin</a>
			<a href={profile.github} target="_blank" rel="noopener noreferrer" class="text-slate-300 underline underline-offset-4 hover:text-amber-400">github</a>
		</p>
	</section>
</main>

<footer class="border-t border-slate-800 py-8 pb-24 text-center text-xs text-slate-400" style={mono}>
	<span class="text-amber-400">$</span> exit · © {new Date().getFullYear()} {profile.name}
</footer>

<style>
	.t-cursor {
		animation: t-blink 1.1s steps(1) infinite;
	}
	@keyframes t-blink {
		50% {
			opacity: 0;
		}
	}
	html {
		scroll-behavior: smooth;
	}
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>
